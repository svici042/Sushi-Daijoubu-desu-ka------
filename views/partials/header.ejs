<!doctype html>
<html lang="<%= language === 'en' ? 'en' : 'nb' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= currentPage === '/' ? 'SUSHI Daijoubu desu ka?' : title + ' | SUSHI Daijoubu desu ka?' %></title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/<%= languageQuery %>" aria-label="SUSHI Daijoubu desu ka? – <%= text.home %>">
        <img src="/images/Fargerik%20sushi-anime%20med%20sakura%20og%20Fuji%20Logo1.png" alt="<%= language === 'en' ? 'Illustrated restaurant logo with sushi chef and lucky cat' : 'Illustrert restaurantlogo med sushi-kokk og lykkekatt' %>">
      </a>
      <p class="japanese-name" lang="ja">大丈夫ですか？</p>
      <!-- Language links reload the same page and keep the choice in navigation links. -->
      <div class="header-actions">
      <a class="header-cart" href="/kurv<%= languageQuery %>" aria-label="<%= text.cart %>" <% if (currentPage === '/kurv' || currentPage === '/handlekurv') { %>aria-current="page"<% } %>>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M2 3h2l2.4 11.5a2 2 0 0 0 2 1.5H19a2 2 0 0 0 2-1.6L22 7H5M9 21h.01M19 21h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="header-cart-badge" data-cart-count hidden></span>
      </a>
      <nav class="language-switch" aria-label="Velg språk / Choose language">
        <a href="<%= languageSwitchPath %>" lang="nb" <% if (language === 'no') { %>aria-current="page"<% } %>>NO</a>
        <a href="<%= languageSwitchPath %><%= languageSwitchPath.includes('?') ? '&' : '?' %>lang=en" lang="en" <% if (language === 'en') { %>aria-current="page"<% } %>>EN</a>
      </nav>
      </div>
    </header>
