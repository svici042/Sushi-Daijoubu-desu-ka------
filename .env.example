# Copy this file to .env and fill in your SQL Server settings.
DB_SERVER=YOUR_SERVER\SQLEXPRESS
DB_NAME=YOUR_DATABASE

DB_AUTH=sql
DB_USER=YOUR_SQL_LOGIN
DB_PASSWORD=YOUR_PASSWORD

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false

# Admin: create your own password hash with:
# node -e "require('bcryptjs').hash(process.argv[1], 12).then(console.log)" "YOUR_CHOSEN_PASSWORD"
# Generate a random session secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Copy only the generated values into your private .env file.
ADMIN_PASSWORD_HASH=YOUR_BCRYPT_HASH
ADMIN_SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARACTERS

# For Windows authentication, use DB_AUTH=windows and omit DB_USER and DB_PASSWORD.

# Uncomment the next line to test the website on a phone connected to the same Wi-Fi network.
# Comment it again when mobile testing is finished.
# HOST=0.0.0.0
