# Copy this file to .env and fill in your SQL Server settings.
DB_SERVER=YOUR_SERVER\SQLEXPRESS
DB_NAME=YOUR_DATABASE
DB_AUTH=sql
DB_USER=YOUR_SQL_LOGIN
DB_PASSWORD=YOUR_PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false

# For Windows authentication, use DB_AUTH=windows and omit DB_USER and DB_PASSWORD.
